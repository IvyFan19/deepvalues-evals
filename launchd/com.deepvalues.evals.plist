<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.deepvalues.evals</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string>
    <string>cd "$HOME/Projects-LULU/deepvalues-evals" &amp;&amp; python3 run.py --keyless >> "$HOME/Library/Logs/deepvalues-evals.log" 2>&amp;1; git add results &amp;&amp; git commit -qm "evals: $(date +%F)" &amp;&amp; git push -q || true</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>15</integer></dict>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/ivy/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>/Users/ivy/Library/Logs/deepvalues-evals.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/ivy/Library/Logs/deepvalues-evals.launchd.log</string>
</dict></plist>
